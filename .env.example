# Copy this file to .env and adjust the values.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: absolute folder with Vosk models (defaults to backend/models_stt).
# Useful on Windows when the project path contains non-Latin letters.
VOSK_MODELS_DIR=
# Optional: folder and model for local background removal (rembg).
# Defaults: backend/models_ai and "u2net". Downloaded by scripts/download_models.py.
REMBG_MODELS_DIR=
REMBG_MODEL=u2net

# AI Studio (optional). Without keys it explains that a grown-up must connect it,
# and Edit mode works fully offline. How to get the keys: README, "AI Studio".
# Gemini (free key, no bank card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cloudflare Workers AI (free daily allowance): Account ID and a Workers AI token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Which service does what. Empty = automatic (Gemini understands, Cloudflare draws).
AI_TEXT_PROVIDER=
AI_IMAGE_PROVIDER=
# Optional model overrides.
GEMINI_MODEL=gemini-3.5-flash-lite
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_SPEECH_MODEL=@cf/openai/whisper-large-v3-turbo
# "provider" (best) or "vosk" (offline, lower quality, saves quota).
AI_TRANSCRIBE_WITH=provider
# AI requests per child per day.
AI_DAILY_LIMIT=30
