# Copy this file to .env and adjust the values.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: absolute folder with Vosk models (defaults to backend/models_stt).
# Useful on Windows when the project path contains non-Latin letters.
VOSK_MODELS_DIR=
# Optional: folder and model for local background removal (rembg).
# Defaults: backend/models_ai and "u2net". Downloaded by scripts/download_models.py.
REMBG_MODELS_DIR=
REMBG_MODEL=u2net
